# Copy to .env (`cp .env.example .env`) and fill in. Never commit .env.
# The placeholder values below are enough to build and run in mock mode; sign-in needs real Entra values.

# --- Database ---
# Postgres connection string (matches docker-compose.yml for local development).
DATABASE_URL="postgresql://cornerops:cornerops@localhost:5432/cornerops?schema=public"

# --- Auth.js / Microsoft Entra ID ---
# Random secret for encrypting sessions, 32+ chars. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-plus-character-secret"
# Entra app registration "Application (client) ID".
AUTH_MICROSOFT_ENTRA_ID_ID="00000000-0000-0000-0000-000000000000"
# Entra app registration client secret VALUE (not the secret ID).
AUTH_MICROSOFT_ENTRA_ID_SECRET="replace-me"
# Entra "Directory (tenant) ID" GUID; restricts sign-in to our tenant only.
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="00000000-0000-0000-0000-000000000000"
# Public base URL of the app; optional locally, set it in production (e.g. https://ops.example.com).
# AUTH_URL="http://localhost:3000"
# Comma-separated emails that are always ADMIN (bootstraps the first admins).
ADMIN_EMAILS="admin@example.com"

# --- Integrations ---
# "mock" (default, JSON fixtures) or "live" (real Syncro/Pax8 APIs, read-only).
INTEGRATIONS_MODE="mock"
# Syncro API base URL, e.g. https://yoursubdomain.syncromsp.com/api/v1 (live mode only).
SYNCRO_BASE_URL=""
# Syncro API token with read-only permissions (live mode only).
SYNCRO_API_KEY=""
# Pax8 API client ID (live mode only).
PAX8_CLIENT_ID=""
# Pax8 API client secret (live mode only).
PAX8_CLIENT_SECRET=""

# --- Reconciliation ---
# Minimum monthly managed revenue per device, in cents (7500 = $75.00).
PRICE_FLOOR_PER_DEVICE_CENTS="7500"
